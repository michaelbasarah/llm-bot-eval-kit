# Optional. Without a key the toy bot runs in fake (offline, deterministic) mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Force fake mode even when a key is set.
TOYBOT_FAKE=

# Demo server
PORT=3000
PERSONA=salon
# If set, /webhook requires a valid x-hub-signature-256 (and the golden gate signs with it).
APP_SECRET=

# Gates
BASE_URL=http://localhost:3000
GOLDEN_AUTH=
GOLDEN_RELAXED=
SMOKE_PASSWORD=
SMOKE_EDGE_URL=
SMOKE_CHROMIUM_PATH=
